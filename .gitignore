# ===== 密钥（切勿提交）=====
.env
.env.*
!.env.example

# ===== 依赖与构建产物（引擎/插件不入库）=====
node_modules/
.dist/
out/

# ===== 本地数据（每台机器独立）=====
.dsh/
data/
dsh-home/
.workbuddy/

# ===== npm 锁文件（引擎由 .bat 跟 npm latest 安装，不入库）=====
package-lock.json
# 例外：离线伴侣插件需要 package.json 才能被 DSH Loader / client-modules 识别
!dsh-extra/plugins/**/package.json

# ===== 系统 / IDE =====
.DS_Store
Thumbs.db
desktop.ini

# ===== 本地部署笔记（含本机细节，不公开）=====
本地部署笔记.md
LOCAL_NOTES.md

# ===== 日志 =====
*.log
